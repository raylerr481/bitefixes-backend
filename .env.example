SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<server-side-secret-or-publishable-key-as-appropriate>
CORS_ORIGINS=https://www.bitefixes.com
DEBUG=false

# Bitey Web Intelligence
BITEY_SEARCH_PRIMARY_URL=https://bitey-search-core.onrender.com
TAVILY_API_KEY=
BITEY_WEB_SEARCH_TIMEOUT=8
BITEY_WEB_CACHE_TTL=900
BITEY_WEB_MAX_QUERIES=3
BITEY_WEB_MAX_RESULTS=8
BITEY_WEB_VERIFY_SCORE=0.72
BITEY_WEB_MEMORY_TTL=2592000
BITEY_WEB_MEMORY_MAX_RESULTS=5

# AI routing: Ollama is local/free by default; cloud providers are optional.
AI_DEFAULT_PROVIDER=ollama
AI_FALLBACK_PROVIDERS=gemini,groq,huggingface
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=800

# Google Gemini API - free tier available with limits; do not commit the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud - optional free tier subject to current rate limits.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face Inference Providers - optional and subject to model/provider availability.
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Ollama local endpoint - no API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional vector backend. Supabase remains the source of truth.
VECTOR_BACKEND=none
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=bitey_knowledge
