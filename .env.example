SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<server-side-secret-or-publishable-key-as-appropriate>
CORS_ORIGINS=https://www.bitefixes.com
DEBUG=false

# Bitey Web Intelligence: Bitey Search Core/SearXNG is primary; Tavily is secondary.
# Brave/Bing/Google search providers are intentionally unsupported.
BITEY_SEARCH_PRIMARY_URL=https://bitey-search-core.onrender.com
TAVILY_API_KEY=
BITEY_SEARCH_TIMEOUT=8
BITEY_WEB_CACHE_TTL=900
BITEY_WEB_MAX_QUERIES=3
BITEY_WEB_MAX_RESULTS=8
BITEY_WEB_VERIFY_SCORE=0.72
BITEY_WEB_MEMORY_TTL=2592000
BITEY_WEB_MEMORY_MAX_RESULTS=5
BITEY_WEB_FETCH_CONTENT=true
BITEY_WEB_FETCH_RESULTS=5
BITEY_WEB_FETCH_TIMEOUT=6
BITEY_WEB_FETCH_MAX_BYTES=120000

# Optional AI providers. Leave unset to keep deterministic Bitey Core only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=true
GROQ_PRIORITY=5
OPENROUTER_PRIORITY=10
