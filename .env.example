SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<server-side-secret-or-publishable-key-as-appropriate>
CORS_ORIGINS=https://www.bitefixes.com
DEBUG=false

# Portal de Suporte / SupportCandy REST integration
SUPPORTCANDY_URL=https://bitefixes.com
SUPPORTCANDY_USERNAME=
SUPPORTCANDY_APP_PASSWORD=
SUPPORTCANDY_SYNC_TOKEN=
SUPPORTCANDY_TIMEOUT=20

# Bitey Web Intelligence
BITEY_SEARCH_PRIMARY_URL=https://bitey-search-core.onrender.com
TAVILY_API_KEY=
BITEY_WEB_SEARCH_TIMEOUT=8
BITEY_WEB_CACHE_TTL=900
BITEY_WEB_MAX_QUERIES=3
BITEY_WEB_MAX_RESULTS=8
BITEY_WEB_VERIFY_SCORE=0.72
BITEY_WEB_MEMORY_TTL=2592000
BITEY_WEB_MEMORY_MAX_RESULTS=5
BITEY_WEB_FETCH_CONTENT=true
BITEY_WEB_FETCH_RESULTS=5
BITEY_WEB_FETCH_TIMEOUT=6
BITEY_WEB_FETCH_MAX_BYTES=120000

# Server-to-server WordPress/channel authentication.
BITEY_CHANNEL_API_KEY=

# HARD ZERO-COST POLICY. Paid/unknown providers are never selected when true.
BITEY_FREE_ONLY=true

BITEYIA_QGROP=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENABLED=true
GROQ_PRIORITY=5
GROQ_REASONING_EFFORT=medium
BITEY_LLM_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_QWEN_MODEL=qwen/qwen3-4b:free
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-chat-v3-0324:free
DEEPSEEK_ENABLED=true
OPENROUTER_PRIORITY=10
QWEN_PRIORITY=10
DEEPSEEK_PRIORITY=15

CLOUDFLARE_AI_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
