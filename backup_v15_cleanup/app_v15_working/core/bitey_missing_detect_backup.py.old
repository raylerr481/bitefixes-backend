"""
Bitey AI Core

Main engine responsible for:

- customer management
- conversation management
- multilingual intent detection
- knowledge search
- ticket creation
- conversation updates
"""


from app.database.supabase import supabase_manager
from app.services.ticket_service import create_ticket
from app.core.language import normalize_message



def find_customer_by_phone(
    company_id,
    phone
):

    supabase = supabase_manager.get_client()

    try:

        result = (
            supabase
            .table("customers")
            .select("*")
            .eq(
                "company_id",
                company_id
            )
            .eq(
                "phone",
                phone
            )
            .execute()
        )


        if result.data:

            return result.data[0]


    except Exception as error:

        print(
            "[CUSTOMER SEARCH ERROR]",
            error
        )


    return None





def create_customer(
    company_id,
    phone,
    name
):

    supabase = supabase_manager.get_client()


    try:

        result = (
            supabase
            .table("customers")
            .insert(
                {
                    "company_id": company_id,
                    "phone": phone,
                    "full_name": name,
                    "preferred_language": "pt-BR",
                    "customer_type": "individual",
                    "is_active": True
                }
            )
            .execute()
        )


        if result.data:

            return result.data[0]


    except Exception as error:

        print(
            "[CUSTOMER CREATE ERROR]",
            error
        )


    return None





def find_or_create_conversation(
    customer_id
):

    supabase = supabase_manager.get_client()


    try:

        result = (
            supabase
            .table("conversations")
            .select("*")
            .eq(
                "customer_id",
                customer_id
            )
            .eq(
                "status",
                "active"
            )
            .limit(1)
            .execute()
        )


        if result.data:

            return result.data[0]



        result = (
            supabase
            .table("conversations")
            .insert(
                {
                    "customer_id": customer_id,
                    "channel": "website",
                    "status": "active",
                    "agent": "bitey",
                    "handled_by_ai": True,
                    "requires_human": False
                }
            )
            .execute()
        )


        if result.data:

            return result.data[0]


    except Exception as error:

        print(
            "[CONVERSATION ERROR]",
            error
        )


    return None
