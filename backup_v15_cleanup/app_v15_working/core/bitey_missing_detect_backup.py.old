def find_existing_ticket(
    customer_id,
    intent
):

    if not intent:

        return None


    supabase = supabase_manager.get_client()


    try:

        result = (
            supabase
            .table("tickets")
            .select("id")
            .eq(
                "customer_id",
                customer_id
            )
            .eq(
                "intent",
                intent
            )
            .eq(
                "status",
                "open"
            )
            .order(
                "id",
                desc=True
            )
            .limit(1)
            .execute()
        )


        if result.data:

            return result.data[0]["id"]


    except Exception as error:

        print(
            "[TICKET SEARCH ERROR]",
            error
        )


    return None





def update_conversation(
    conversation_id,
    ticket_id,
    intent,
    response
):

    supabase = supabase_manager.get_client()


    try:

        (
            supabase
            .table("conversations")
            .update(
                {
                    "ticket_id": ticket_id,
                    "last_intent": intent,
                    "last_response": response,
                    "handled_by_ai": True,
                    "requires_human": False
                }
            )
            .eq(
                "id",
                conversation_id
            )
            .execute()
        )


    except Exception as error:

        print(
            "[CONVERSATION UPDATE ERROR]",
            error
        )





def process_message(
    company_id: int,
    phone: str,
    message: str,
    customer_name: str
):


    # Cliente

    customer = find_customer_by_phone(
        company_id,
        phone
    )


    if not customer:

        customer = create_customer(
            company_id,
            phone,
            customer_name
        )



    if not customer:

        return {
            "error": "Customer creation failed"
        }



    customer_id = customer["id"]




    # Conversa

    conversation = find_or_create_conversation(
        customer_id
    )


    if not conversation:

        return {
            "error": "Conversation creation failed"
        }



    conversation_id = conversation["id"]




    # IA

    intent, confidence = detect_intent(
        message
    )



    knowledge = find_knowledge(
        message,
        intent
    )





    if knowledge:

        response = knowledge.get(
            "answer"
        )


        # Corrige intent vindo da base

        if not intent:

            intent = knowledge.get(
                "intent"
            )


    else:

        response = (
            "Recebi sua solicitação. "
            "Vou encaminhar para análise técnica."
        )






    # Ticket existente

    ticket_id = find_existing_ticket(
        customer_id,
        intent
    )





    # Cria ticket novo

    if not ticket_id and intent:


        titles = {


            "hardware_upgrade":
                "Notebook lento",


            "mobile_screen_repair":
                "Troca de tela",


            "screen_repair":
                "Troca de tela",


            "battery_problem":
                "Problema de bateria",


            "network_support":
                "Problema de rede",


            "computer_repair":
                "Manutenção computador"

        }





        ticket = create_ticket(

            company_id=company_id,

            customer_id=customer_id,

            title=titles.get(
                intent,
                "Novo atendimento"
            ),

            description=message,

            intent=intent

        )



        if ticket:

            ticket_id = ticket["id"]





    update_conversation(

        conversation_id,

        ticket_id,

        intent,

        response

    )





    return {


        "customer_id":
            customer_id,


        "conversation_id":
            conversation_id,


        "response":
            response,


        "intent":
            intent,


        "confidence":
            confidence,


        "knowledge_found":
            bool(knowledge),


        "ticket_id":
            ticket_id,


        "channel":
            "website"

    }
    