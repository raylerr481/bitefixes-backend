"""
Ticket Service

Creates support tickets generated by Bitey.
"""

from datetime import datetime, timezone

from app.supabase_client import supabase



def create_ticket(
    company_id: int,
    customer_id: int,
    title: str,
    description: str,
    intent: str | None = None
):

    data = {

        "company_id": company_id,

        "customer_id": customer_id,

        "title": title,

        "description": description,

        "status": "open",

        "priority": "normal",

        "intent": intent,

        "created_at":
            datetime.now(
                timezone.utc
            ).isoformat()

    }


    try:

        result = (
            supabase
            .table("tickets")
            .insert(data)
            .execute()
        )


        if result.data:

            return result.data[0]


    except Exception as error:

        print(
            "[TICKET SERVICE ERROR]",
            error
        )


    return None