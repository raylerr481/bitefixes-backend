"""
Bitey AI Core

Main engine responsible for:
- intent detection
- knowledge search
- ticket creation
- conversation updates
"""

from app.database.supabase import supabase_manager
from app.services.ticket_service import create_ticket



def detect_intent(message: str):

    text = message.lower().strip()


    # Hardware / performance
    if (
        (
            "notebook" in text
            or "computador" in text
            or "pc" in text
            or "desktop" in text
        )
        and
        (
            "lento" in text
            or "travando" in text
            or "trava" in text
            or "desempenho" in text
            or "upgrade" in text
            or "melhorar" in text
        )
    ):
        return "hardware_upgrade", 1



    # Screen repair
    if (
        "tela" in text
        and
        (
            "quebrada" in text
            or "quebrou" in text
            or "rachada" in text
            or "trocar" in text
            or "substituir" in text
        )
    ):
        return "screen_repair", 1



    # Battery
    if (
        "bateria" in text
        and
        (
            "ruim" in text
            or "descarrega" in text
            or "carga" in text
        )
    ):
        return "battery_problem", 1



    # Network
    if (
        "wifi" in text
        or "internet" in text
        or "rede" in text
    ):
        return "network_support", 1



    return None, 0





def find_knowledge(message):

    supabase = supabase_manager.get_client()


    try:

        result = (
            supabase
            .table("knowledge_base")
            .select("*")
            .execute()
        )


        if not result.data:
            return None



        words = [
            w.lower()
            for w in message.split()
            if len(w) > 3
        ]



        for item in result.data:

            content = (
                str(item.get("question",""))
                +
                " "
                +
                str(item.get("answer",""))
            ).lower()



            matches = 0


            for word in words:

                if word in content:
                    matches += 1



            if matches >= 1:
                return item



    except Exception as error:

        print(
            "[KNOWLEDGE ERROR]",
            error
        )


    return None






def find_existing_ticket(
    customer_id,
    intent
):

    if not intent:
        return None



    supabase = supabase_manager.get_client()



    try:

        result = (
            supabase
            .table("tickets")
            .select("id")
            .eq(
                "customer_id",
                customer_id
            )
            .eq(
                "intent",
                intent
            )
            .eq(
                "status",
                "open"
            )
            .order(
                "id",
                desc=True
            )
            .limit(1)
            .execute()
        )



        if result.data:

            return result.data[0]["id"]



    except Exception as error:

        print(
            "[TICKET SEARCH ERROR]",
            error
        )



    return None






def update_conversation(
    conversation_id,
    ticket_id,
    intent,
    response
):

    supabase = supabase_manager.get_client()



    try:

        (
            supabase
            .table("conversations")
            .update(
                {
                    "ticket_id": ticket_id,
                    "last_intent": intent,
                    "last_response": response,
                    "handled_by_ai": True,
                    "requires_human": False
                }
            )
            .eq(
                "id",
                conversation_id
            )
            .execute()
        )


    except Exception as error:

        print(
            "[CONVERSATION ERROR]",
            error
        )








def process_message(
    company_id: int,
    phone: str,
    message: str,
    customer_name: str
):


    customer_id = 1

    conversation_id = 1



    intent, confidence = detect_intent(
        message
    )



    knowledge = find_knowledge(
        message
    )



    if knowledge:

        response = knowledge.get(
            "answer"
        )

    else:

        response = (
            "Recebi sua solicitação. "
            "Vou encaminhar para análise técnica."
        )



    ticket_id = find_existing_ticket(
        customer_id,
        intent
    )



    # Não cria ticket sem intenção válida
    if not ticket_id and intent:


        titles = {

            "hardware_upgrade":
                "Notebook lento",

            "screen_repair":
                "Troca de tela",

            "battery_problem":
                "Problema de bateria",

            "network_support":
                "Problema de rede"

        }



        ticket = create_ticket(

            company_id=company_id,

            customer_id=customer_id,

            title=titles.get(
                intent,
                "Novo atendimento"
            ),

            description=message,

            intent=intent

        )



        if ticket:

            ticket_id = ticket["id"]






    update_conversation(

        conversation_id,

        ticket_id,

        intent,

        response

    )




    return {

        "customer_id":
            customer_id,

        "conversation_id":
            conversation_id,

        "response":
            response,

        "intent":
            intent,

        "confidence":
            confidence,

        "knowledge_found":
            bool(knowledge),

        "ticket_id":
            ticket_id,

        "channel":
            "website"

    }