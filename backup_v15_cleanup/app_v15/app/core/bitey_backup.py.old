"""
Bitey AI Core Engine

Central intelligence layer.

Flow:

Customer
    |
Conversation
    |
Message Memory
    |
Intent Detection
    |
Knowledge Search
    |
Ticket Creation
    |
AI Logs
    |
Response
"""


from app.services.customer_service import (
    get_or_create_customer
)

from app.services.conversation_service import (
    get_or_create_conversation
)

from app.services.message_service import (
    save_customer_message,
    save_bitey_message
)

from app.services.intent_service import (
    detect_intent
)

from app.services.knowledge_service import (
    search_knowledge
)

from app.services.ticket_service import (
    create_ticket
)

from app.services.ai_log_service import (
    save_ai_decision
)



def process_message(
    company_id: int,
    phone: str,
    message: str,
    customer_name: str = None,
    channel: str = "website"
):


    # ==========================
    # Customer
    # ==========================

    customer = get_or_create_customer(

        phone=phone,

        full_name=customer_name,

        company_id=company_id

    )


    customer_id = customer["id"]



    # ==========================
    # Conversation
    # ==========================

    conversation = get_or_create_conversation(

        customer_id=customer_id,

        channel=channel

    )


    conversation_id = conversation["id"]



    # ==========================
    # Save customer message
    # ==========================

    save_customer_message(

        conversation_id=conversation_id,

        customer_id=customer_id,

        message_content=message,

        channel=channel,

        company_id=company_id

    )



    # ==========================
    # Detect intent
    # ==========================

    intent_result = detect_intent(

        company_id,

        message

    )


    intent = None

    confidence = 0


    if intent_result:

        intent = intent_result.get(
            "intent"
        )

        confidence = intent_result.get(
            "confidence",
            0
        )



    # ==========================
    # Knowledge
    # ==========================

    knowledge = search_knowledge(

        company_id,

        message

    )


    response = (
        "Thank you for contacting BiteFixes. "
        "I will analyze your request."
    )


    knowledge_found = False

    knowledge_id = None



    if knowledge:


        knowledge_found = True

        knowledge_id = knowledge.get(
            "id"
        )


        response = knowledge.get(
            "answer",
            response
        )



    # ==========================
    # Ticket
    # ==========================

    ticket = None


    if (

        knowledge

        and knowledge.get(
            "requires_ticket"
        )

    ):


        ticket = create_ticket(

            company_id=company_id,

            customer_id=customer_id,

            title=knowledge.get(
                "title"
            ),

            description=message,

            intent=intent

        )



    # ==========================
    # Save Bitey response
    # ==========================

    save_bitey_message(

        conversation_id=conversation_id,

        customer_id=customer_id,

        response_text=response,

        intent=intent,

        confidence=confidence,

        channel=channel,

        company_id=company_id

    )



    # ==========================
    # AI Log
    # ==========================

    save_ai_decision(

        conversation_id=conversation_id,

        input_message=message,

        intent=intent,

        confidence=confidence,

        response_text=response,

        knowledge_found=knowledge_found,

        knowledge_id=knowledge_id,

        company_id=company_id

    )



    return {

        "customer_id": customer_id,

        "conversation_id": conversation_id,

        "response": response,

        "intent": intent,

        "confidence": confidence,

        "knowledge_found": knowledge_found,

        "ticket_id": ticket["id"] if ticket else None,

        "channel": channel

    }